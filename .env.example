# Configuración de Base de Datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Autenticación JWT (Generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars-long"

# Duración de Tokens
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Configuración de Aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
